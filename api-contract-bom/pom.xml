<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.apicontract</groupId>
    <artifactId>api-contract-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>api-contract-bom</artifactId>
  <packaging>pom</packaging>

  <name>ApiContract BOM</name>
  <description>ApiContract 版本统一管理（BOM）：业务与网关经 BOM 引入四件套，
    保证契约定义模块版本一致，发布前完成兼容性检查</description>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.apicontract</groupId>
        <artifactId>api-contract-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.apicontract</groupId>
        <artifactId>api-contract-provider-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.apicontract</groupId>
        <artifactId>api-contract-gateway-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.apicontract</groupId>
        <artifactId>api-contract-nacos-adapter</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
